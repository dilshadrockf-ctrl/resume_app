{
  "name": "resume-forge",
  "version": "0.1.0",
  "private": true,
  "description": "Self-hosted AI Resume Builder + ATS Optimizer. Local-first, cloud-portable.",
  "license": "MIT",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "predev": "node scripts/ensure-prisma-client.mjs",
    "dev": "next dev -H 0.0.0.0",
    "build": "prisma generate && next build",
    "prestart": "node scripts/ensure-prisma-client.mjs",
    "start": "next start -H 0.0.0.0",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "setup": "node scripts/setup.mjs",
    "env:check": "tsx scripts/env-check.ts",
    "postinstall": "node scripts/ensure-prisma-client.mjs",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:push": "prisma db push",
    "db:seed": "prisma db seed",
    "db:reset": "prisma migrate reset --force",
    "db:studio": "prisma studio --port 5555 --browser none",
    "preworker": "node scripts/ensure-prisma-client.mjs",
    "worker": "tsx src/workers/main.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "node scripts/smoke.mjs",
    "db:local": "node scripts/sandbox-db.mjs start",
    "db:local:stop": "node scripts/sandbox-db.mjs stop",
    "db:offline:gen": "node scripts/db-offline.mjs",
    "db:offline:apply": "node scripts/db-apply-sql.mjs"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.9.1",
    "@aws-sdk/client-s3": "^3.1127.0",
    "@aws-sdk/s3-request-presigner": "^3.1127.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@expo-google-fonts/inter": "^0.4.2",
    "@expo-google-fonts/jetbrains-mono": "^0.4.1",
    "@expo-google-fonts/lora": "^0.4.2",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/lora": "^5.3.0",
    "@node-rs/argon2": "^2.2.0",
    "@pdf-lib/fontkit": "^1.1.1",
    "@prisma/adapter-pg": "^6.19.3",
    "@prisma/client": "^6.19.3",
    "@radix-ui/react-alert-dialog": "^1.1.23",
    "@radix-ui/react-checkbox": "^1.3.11",
    "@radix-ui/react-collapsible": "^1.1.20",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-progress": "^1.1.16",
    "@radix-ui/react-radio-group": "^1.4.7",
    "@radix-ui/react-scroll-area": "^1.2.18",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-separator": "^1.1.15",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-switch": "^1.3.7",
    "@radix-ui/react-tabs": "^1.1.21",
    "@radix-ui/react-toggle-group": "^1.1.19",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@types/pg": "^8.23.1",
    "bullmq": "^6.3.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "docx": "^9.7.1",
    "framer-motion": "^13.2.0",
    "ioredis": "^6.0.0",
    "lucide-react": "^1.42.0",
    "mammoth": "^1.12.2",
    "nanoid": "^6.0.1",
    "next": "^16.3.4",
    "next-auth": "5.0.0-beta.32",
    "nodemailer": "^8.0.5",
    "pdf-lib": "^1.17.1",
    "pg": "^8.16.3",
    "prisma": "^6.19.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "unpdf": "^1.3.2",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/jsdom": "^21.1.7",
    "@types/node": "^22.20.1",
    "@types/nodemailer": "^7.0.4",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.4",
    "fflate": "^0.8.3",
    "jsdom": "^30.0.1",
    "postcss": "^8.5.6",
    "prettier": "^3.9.6",
    "tailwindcss-animate": "^1.0.7",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3",
    "vitest": "^5.0.0"
  },
  "optionalDependencies": {
    "@embedded-postgres/darwin-arm64": "^16.4.0-beta.13",
    "@embedded-postgres/darwin-x64": "^16.4.0-beta.13",
    "@embedded-postgres/linux-arm64": "^16.4.0-beta.13",
    "@embedded-postgres/linux-x64": "^16.4.0-beta.13",
    "@embedded-postgres/windows-x64": "^16.4.0-beta.13"
  }
}
