# ──────────────────────────────────────────────────────────────────────────────
# ResumeForge — environment template. Copy to `.env` and adjust.
# Every service below is OPTIONAL except PostgreSQL: the app degrades
# gracefully (filesystem storage, in-memory rate limiting, logged emails,
# in-process job runner, "AI not configured" state) when a service is absent.
# ──────────────────────────────────────────────────────────────────────────────

NODE_ENV=development
APP_NAME=ResumeForge

# Core URLs ---------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Comma-separated additional origins the app should accept (preview/proxy hosts, prod domain).
TRUSTED_ORIGINS=

# PostgreSQL (required) ----------------------------------------------------
# Local docker compose default:
DATABASE_URL=postgresql://resume:resume@localhost:5432/resumebuilder
# Docker service hostname when running inside the compose network:
# DATABASE_URL=postgresql://resume:resume@postgres:5432/resumebuilder

# Auth.js -----------------------------------------------------------------
# Generate with: openssl rand -base64 32
AUTH_SECRET=
AUTH_URL=http://localhost:3000
AUTH_TRUST_HOST=true

# Redis (optional — in-memory fallback when unset/unreachable) ------------
REDIS_URL=redis://localhost:6379
# REDIS_URL=redis://redis:6379
QUEUE_PREFIX=resumeforge
# Run queue jobs inside the web process when no worker is available (dev convenience)
QUEUE_INPROCESS=true

# Object storage (optional — filesystem fallback to ./storage) ------------
STORAGE_DRIVER=auto          # auto | minio | filesystem
S3_ENDPOINT=http://localhost:9000
# S3_ENDPOINT=http://minio:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=resumeforge
S3_SECRET_KEY=resumeforge-secret
S3_BUCKET=resumes
FILESYSTEM_STORAGE_DIR=./storage

# Email (optional — dev fallback prints links to server logs) -------------
MAIL_DRIVER=auto             # auto | smtp | log
MAIL_HOST=localhost
MAIL_PORT=1025               # Mailpit SMTP
MAIL_USER=
MAIL_PASSWORD=
MAIL_SECURE=false
MAIL_FROM="ResumeForge <noreply@localhost>"

# AI provider (optional — core product works without it) ------------------
# Provider: none | ollama | openai | anthropic | google | openai-compatible
AI_PROVIDER=none
# Ollama:            http://localhost:11434   (inside docker: http://host.docker.internal:11434)
# LM Studio:         http://localhost:1234/v1 (openai-compatible)
# OpenAI:            https://api.openai.com/v1
AI_BASE_URL=
AI_API_KEY=
AI_DEFAULT_MODEL=
AI_FAST_MODEL=
AI_REASONING_MODEL=
# Optional fallback provider (only used if explicitly configured)
AI_FALLBACK_PROVIDER=none
AI_FALLBACK_BASE_URL=
AI_FALLBACK_API_KEY=
AI_FALLBACK_MODEL=
AI_MAX_INPUT_CHARS=24000
AI_TIMEOUT_MS=120000
AI_DAILY_TOKEN_BUDGET=0      # 0 = unlimited (dev), set in prod

# Billing / entitlements ----------------------------------------------------
BILLING_ENABLED=false
FREE_PLAN_UNLIMITED=true

# Feature flags (comma list of keys forced on; DB flags also supported) -----
FEATURE_FLAGS_ON=

# Rate limits (requests per window) ------------------------------------------
RATE_LIMIT_LOGIN=5
RATE_LIMIT_REGISTER=3
RATE_LIMIT_AI=30
RATE_LIMIT_IMPORT=10
RATE_LIMIT_EXPORT=30
RATE_LIMIT_PUBLIC_RESUME=120

# Ports consumed by docker compose (defaults match .env.example above) ------
POSTGRES_PORT=5432
POSTGRES_USER=resume
POSTGRES_PASSWORD=resume
POSTGRES_DB=resumebuilder
REDIS_PORT=6379
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ROOT_USER=resumeforge
MINIO_ROOT_PASSWORD=resumeforge-secret
MINIO_BUCKET=resumes
MAILPIT_HTTP_PORT=8025
MAILPIT_SMTP_PORT=1025
WEB_PORT=3000

# Logging --------------------------------------------------------------------
LOG_LEVEL=info                 # debug | info | warn | error
LOG_FORMAT=pretty              # pretty | json

# Development-only demo account seeding (seed script) --------------------------
SEED_DEMO_USER=demo@example.com
SEED_DEMO_PASSWORD=demo-password-123
